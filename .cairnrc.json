{
  "ignore": ["**/node_modules/**"],
  "naming": {
    "dirSummary": "_SUMMARY.md",
    "fileSummarySuffix": ".summary.md"
  },
  "roots": ["docs"],
  "thresholdLines": 30,
  "checks": {
    "coverage": {
      "kinds": [
        {
          "id": "101-design-package",
          "select": { "by": "path", "glob": "**/docs/design/101-refs-symbol-scoping/_SUMMARY.md" }
        },
        {
          "id": "101-problem-space",
          "select": { "by": "path", "glob": "**/docs/design/101-refs-symbol-scoping/problem-space.md" }
        },
        {
          "id": "101-solution-space",
          "select": { "by": "path", "glob": "**/docs/design/101-refs-symbol-scoping/solution-space.md" }
        },
        { "id": "101-spikes", "select": { "by": "path", "glob": "**/docs/design/101-refs-symbol-scoping/spikes.md" } },
        {
          "id": "101-story-map",
          "select": { "by": "path", "glob": "**/docs/design/101-refs-symbol-scoping/story-map.md" }
        },
        {
          "id": "101-roadmap",
          "select": { "by": "path", "glob": "**/docs/design/101-refs-symbol-scoping/roadmap.md" }
        },
        {
          "id": "101-implementation-details",
          "select": { "by": "path", "glob": "**/docs/design/101-refs-symbol-scoping/implementation-details.md" }
        },
        {
          "id": "101-knowledge",
          "select": { "by": "path", "glob": "**/docs/design/101-refs-symbol-scoping/knowledge.md" }
        }
      ],
      "rules": [
        { "from": "101-design-package", "to": "101-problem-space" },
        { "from": "101-design-package", "to": "101-solution-space" },
        { "from": "101-design-package", "to": "101-spikes" },
        { "from": "101-design-package", "to": "101-story-map" },
        { "from": "101-design-package", "to": "101-roadmap" },
        { "from": "101-design-package", "to": "101-implementation-details" },
        { "from": "101-design-package", "to": "101-knowledge" },
        { "from": "101-solution-space", "to": "101-spikes", "name": "grounded_by" },
        { "from": "101-roadmap", "to": "101-spikes", "name": "grounded_by" },
        { "from": "101-problem-space", "to": "101-spikes", "name": "grounded_by" },
        { "from": "101-implementation-details", "to": "101-spikes", "name": "builds_on" },
        { "from": "101-knowledge", "to": "101-spikes", "name": "sourced_from" },
        { "from": "101-roadmap", "to": "101-story-map", "name": "derived_from" }
      ]
    },
    "docCoverage": {
      "sources": ["src/**/*.ts"],
      "coveredBy": [
        { "glob": "docs/architecture.md", "kind": "architecture" },
        { "glob": "docs/adr/**", "kind": "adr" }
      ],
      "exempt": ["src/**/*.test.ts", "src/**/*.bench.ts", "src/testSupport/**"]
    }
  }
}
