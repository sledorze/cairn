{
  "ignore": ["**/node_modules/**"],
  "naming": {
    "dirSummary": "_SUMMARY.md",
    "fileSummarySuffix": ".summary.md"
  },
  "roots": ["docs"],
  "thresholdLines": 30,
  "checks": {
    "coverage": {
      "kinds": [
        { "id": "design-package", "select": { "by": "path", "glob": "**/docs/design/*/_SUMMARY.md" } },
        { "id": "problem-space", "select": { "by": "path", "glob": "**/docs/design/*/problem-space.md" } },
        { "id": "solution-space", "select": { "by": "path", "glob": "**/docs/design/*/solution-space.md" } },
        { "id": "spikes", "select": { "by": "path", "glob": "**/docs/design/*/spikes.md" } },
        { "id": "story-map", "select": { "by": "path", "glob": "**/docs/design/*/story-map.md" } },
        { "id": "roadmap", "select": { "by": "path", "glob": "**/docs/design/*/roadmap.md" } },
        {
          "id": "implementation-details",
          "select": { "by": "path", "glob": "**/docs/design/*/implementation-details.md" }
        },
        { "id": "knowledge", "select": { "by": "path", "glob": "**/docs/design/*/knowledge.md" } }
      ],
      "rules": [
        { "from": "design-package", "scope": "sibling", "to": "problem-space" },
        { "from": "design-package", "scope": "sibling", "to": "solution-space" },
        { "from": "design-package", "scope": "sibling", "to": "spikes" },
        { "from": "design-package", "scope": "sibling", "to": "story-map" },
        { "from": "design-package", "scope": "sibling", "to": "roadmap" },
        { "from": "design-package", "scope": "sibling", "to": "implementation-details" },
        { "from": "design-package", "scope": "sibling", "to": "knowledge" },
        {
          "from": "solution-space",
          "description": "A cost/feasibility/risk claim needs real evidence — cite the spike that backs it.",
          "name": "grounded_by",
          "scope": "sibling",
          "to": "spikes"
        },
        {
          "from": "roadmap",
          "description": "A sequencing decision needs real evidence — cite the spike that justifies it.",
          "name": "grounded_by",
          "scope": "sibling",
          "to": "spikes"
        },
        {
          "from": "problem-space",
          "description": "A risk/investment claim needs real evidence — cite the spike that backs it.",
          "name": "grounded_by",
          "scope": "sibling",
          "to": "spikes"
        },
        {
          "from": "implementation-details",
          "description": "An implementation approach must be built on a validated primitive, not assumed — cite the spike that confirmed it works.",
          "name": "builds_on",
          "scope": "sibling",
          "to": "spikes"
        },
        {
          "from": "knowledge",
          "description": "Instructional guidance restating a spike's findings must cite the spike it's sourced from, so a reader can verify it's still accurate.",
          "name": "sourced_from",
          "scope": "sibling",
          "to": "spikes"
        },
        {
          "from": "roadmap",
          "description": "A roadmap that realizes a story-map concept (e.g. a walking skeleton) must cite the story-map doc it derives from.",
          "name": "derived_from",
          "scope": "sibling",
          "to": "story-map"
        }
      ]
    },
    "docCoverage": {
      "sources": ["src/**/*.ts"],
      "coveredBy": [
        { "glob": "docs/architecture.md", "kind": "architecture" },
        { "glob": "docs/adr/**", "kind": "adr" }
      ],
      "exempt": ["src/**/*.test.ts", "src/**/*.bench.ts", "src/testSupport/**"]
    }
  }
}
