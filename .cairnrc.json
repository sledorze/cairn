{
  "ignore": ["**/node_modules/**"],
  "naming": {
    "dirSummary": "_SUMMARY.md",
    "fileSummarySuffix": ".summary.md"
  },
  "roots": ["docs"],
  "thresholdLines": 30,
  "checks": {
    "docCoverage": {
      "sources": ["src/**/*.ts"],
      "coveredBy": [
        { "glob": "docs/architecture.md", "kind": "architecture" },
        { "glob": "docs/adr/**", "kind": "adr" }
      ],
      "exempt": ["src/**/*.test.ts", "src/**/*.bench.ts", "src/testSupport/**"]
    }
  }
}
